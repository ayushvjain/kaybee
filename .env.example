# Copy this file to .env and fill in the values. .env is gitignored.
# This repository is PUBLIC - never commit real keys or secrets.

# Web3Forms access key for the enquiry form (https://web3forms.com).
# Must be the UUID Web3Forms emails you, e.g.
#   PUBLIC_WEB3FORMS_KEY=a1b2c3d4-e5f6-7890-abcd-ef1234567890
# Read at BUILD time, so a rebuild is needed after changing it.
PUBLIC_WEB3FORMS_KEY=

# Keystatic GitHub App credentials, for admin sign-in on the deployed site.
# Not needed for local development, which uses file storage.
# Create the App at https://github.com/settings/apps - see README.md.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
