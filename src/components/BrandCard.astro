---
import { RELATIONSHIP_LABEL, type Brand } from '../lib/content';

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
const label = RELATIONSHIP_LABEL[brand.relationship];
---

<article class:list={['bcard', `bcard--${brand.relationship}`]}>
  <div class="bcard__head">
    {
      brand.logo ? (
        <img class="bcard__logo" src={brand.logo} alt={`${brand.name} logo`} loading="lazy" />
      ) : (
        /*
         * Most brands have no logo asset supplied, so the wordmark is set
         * typographically. Keeps all brands visually consistent rather than
         * mixing a couple of logos with a row of gaps.
         */
        <p class="bcard__wordmark">{brand.name}</p>
      )
    }
    <span class="bcard__rel">{label}</span>
  </div>

  {brand.blurb && <p class="bcard__blurb">{brand.blurb}</p>}

  {
    brand.ranges.length > 0 && (
      <div class="bcard__ranges">
        <h3 class="bcard__ranges-title">Ranges supplied</h3>
        <ul>
          {brand.ranges.map((r) => (
            <li>{r}</li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .bcard {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    padding: var(--kb-space-5);
    background: var(--kb-white);
    border: var(--kb-border);
    border-top: 3px solid var(--kb-grey-300);
    border-radius: var(--kb-radius-lg);
    transition: box-shadow var(--kb-transition), transform var(--kb-transition);
  }

  .bcard:hover {
    box-shadow: var(--kb-shadow);
    transform: translateY(-2px);
  }

  .bcard--own {
    border-top-color: var(--kb-blue);
    background: linear-gradient(180deg, var(--kb-blue-tint) 0%, var(--kb-white) 45%);
  }

  .bcard--authorised-distributor {
    border-top-color: var(--kb-cyan);
  }

  .bcard--partner {
    border-top-color: var(--kb-sky);
  }

  .bcard__head {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-2);
  }

  .bcard__logo {
    height: 44px;
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  .bcard__wordmark {
    font-size: var(--kb-text-2xl);
    font-weight: 750;
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--kb-blue);
  }

  .bcard__rel {
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kb-text-subtle);
  }

  .bcard--own .bcard__rel,
  .bcard--authorised-distributor .bcard__rel {
    color: var(--kb-blue-mid);
  }

  .bcard__blurb {
    font-size: var(--kb-text-sm);
    color: var(--kb-text-muted);
    line-height: 1.6;
  }

  .bcard__ranges {
    margin-top: auto;
    padding-top: var(--kb-space-4);
    border-top: 1px solid var(--kb-grey-100);
  }

  .bcard__ranges-title {
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kb-text-subtle);
    margin-bottom: var(--kb-space-2);
  }

  .bcard__ranges ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bcard__ranges li {
    padding: 0.15rem 0.5rem;
    background: var(--kb-grey-50);
    border: 1px solid var(--kb-grey-200);
    border-radius: 100px;
    font-size: 0.75rem;
    color: var(--kb-text-muted);
  }
</style>
