---
import BaseLayout from '../layouts/BaseLayout.astro';
import Watermark from '../components/Watermark.astro';
import { getProducts } from '../lib/content';

const products = await getProducts();
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found. Browse the Kaybee International product range instead."
>
  <section class="nf">
    <Watermark position="right" size="520px" tone="paper" />
    <div class="kb-container nf__inner">
      <p class="nf__code">404</p>
      <h1>We could not find that page</h1>
      <p class="nf__lede">
        The address may have changed, or the link that brought you here may be out of date. These
        are the places most people are looking for.
      </p>

      <ul class="nf__links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/size-reference">Size reference</a></li>
        <li><a href="/contact">Contact us</a></li>
      </ul>

      <div class="nf__products">
        <h2>Our product range</h2>
        <ul>
          {
            products.map((p) => (
              <li>
                <a href={`/products/${p.slug}`}>{p.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 6vw, 6rem);
  }

  .nf__inner {
    position: relative;
    z-index: 1;
    max-width: 62ch;
  }

  .nf__code {
    font-size: clamp(3rem, 2rem + 6vw, 5rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.04em;
    background: var(--kb-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nf h1 {
    margin-top: var(--kb-space-3);
    font-size: var(--kb-text-3xl);
  }

  .nf__lede {
    margin-top: var(--kb-space-4);
    font-size: var(--kb-text-lg);
    color: var(--kb-text-muted);
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kb-space-3);
    list-style: none;
    padding: 0;
    margin-top: var(--kb-space-6);
  }

  .nf__links a {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    background: var(--kb-white);
    border: 1px solid var(--kb-grey-300);
    border-radius: 100px;
    font-size: var(--kb-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .nf__links a:hover {
    border-color: var(--kb-blue);
    background: var(--kb-blue-tint);
  }

  .nf__products {
    margin-top: var(--kb-space-8);
    padding-top: var(--kb-space-5);
    border-top: 2px solid var(--kb-grey-100);
  }

  .nf__products h2 {
    font-size: var(--kb-text-xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kb-text-subtle);
    margin-bottom: var(--kb-space-3);
  }

  .nf__products ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem var(--kb-space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--kb-text-sm);
    font-weight: 550;
  }
</style>
