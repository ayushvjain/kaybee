---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getProducts, getBrands, RELATIONSHIP_LABEL, type Product, type Brand } from '../../lib/content';
import { withBase, absoluteUrl, SITE_URL } from '../../lib/url';

export async function getStaticPaths() {
  const products = await getProducts();
  const brands = await getBrands();

  return products.map((product) => ({
    params: { slug: product.slug },
    props: {
      product,
      // Resolve the brand relationships once at build time.
      productBrands: product.brands
        .map((slug) => brands.find((b) => b.slug === slug))
        .filter((b): b is Brand => Boolean(b)),
      others: products.filter((p) => p.slug !== product.slug).slice(0, 3),
    },
  }));
}

interface Props {
  product: Product;
  productBrands: Brand[];
  others: Product[];
}

const { product, productBrands, others } = Astro.props;

const description =
  product.seoDescription || product.summary || `${product.name} supplied by Kaybee International, Chennai.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.summary,
  category: 'Bearing accessories',
  brand: productBrands.map((b) => ({ '@type': 'Brand', name: b.name })),
  ...(product.images[0]?.file ? { image: absoluteUrl(product.images[0].file) } : {}),
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    seller: { '@id': `${SITE_URL}/#organisation` },
  },
};
---

<BaseLayout
  title={product.seoTitle || product.name}
  description={description}
  schema={schema}
  ogType="product"
>
  <PageHero
    eyebrow="Product"
    title={product.name}
    lede={product.summary}
    crumbs={[{ href: '/products', label: 'Products' }]}
  />

  <section class="kb-section">
    <div class="kb-container detail">
      <!-- ---------- main column ---------- -->
      <div class="detail__main">
        <div class="detail__gallery">
          {
            product.images.length > 0 ? (
              product.images.map((img, i) =>
                img.file ? (
                  <img
                    src={withBase(img.file)}
                    alt={img.alt}
                    width="860"
                    height="645"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : null
              )
            ) : (
              <ImagePlaceholder label={`${product.name} photograph to follow`} ratio="4 / 3" />
            )
          }
        </div>

        {product.descriptionHtml && (
          <div class="kb-prose detail__prose" set:html={product.descriptionHtml} />
        )}
      </div>

      <!-- ---------- sidebar ---------- -->
      <aside class="detail__side">
        {
          product.features.length > 0 && (
            <div class="panel">
              <h2 class="panel__title">Key features</h2>
              <ul class="panel__features">
                {product.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          (product.series.length > 0 || product.shaftSizeRange) && (
            <div class="panel">
              <h2 class="panel__title">Availability</h2>
              <dl class="panel__spec">
                {product.series.length > 0 && (
                  <>
                    <dt>Series</dt>
                    <dd>{product.series.join(', ')}</dd>
                  </>
                )}
                {product.shaftSizeRange && (
                  <>
                    <dt>Shaft sizes</dt>
                    <dd>{product.shaftSizeRange}</dd>
                  </>
                )}
              </dl>
              {product.series.length > 0 && (
                <a class="panel__link" href={withBase("/size-reference")}>
                  View the full size reference &rarr;
                </a>
              )}
            </div>
          )
        }

        {
          productBrands.length > 0 && (
            <div class="panel">
              <h2 class="panel__title">Available brands</h2>
              <ul class="panel__brands">
                {productBrands.map((b) => (
                  <li>
                    <span class="panel__brand-name">{b.name}</span>
                    <span class="panel__brand-rel">{RELATIONSHIP_LABEL[b.relationship]}</span>
                  </li>
                ))}
              </ul>
              <a class="panel__link" href={withBase("/brands")}>All brands &rarr;</a>
            </div>
          )
        }

        <div class="panel panel--cta">
          <h2 class="panel__title">Enquire about {product.name}</h2>
          <p>
            Tell us the shaft size, series or the part you are replacing and we will confirm what
            we hold.
          </p>
          <a class="kb-btn kb-btn--primary" href={withBase("/contact#enquiry")}>Send an enquiry</a>
        </div>
      </aside>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="kb-section kb-section--tint">
        <div class="kb-container">
          <h2 class="others__title">Other products</h2>
          <ul class="others">
            {others.map((o) => (
              <li>
                <a href={withBase(`/products/${o.slug}`)}>
                  <span class="others__name">{o.name}</span>
                  <span class="others__sum">{o.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 3.5rem);
    align-items: start;
  }

  .detail__gallery {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    margin-bottom: var(--kb-space-6);
  }

  .detail__gallery img {
    width: 100%;
    border-radius: var(--kb-radius-lg);
    border: var(--kb-border);
  }

  .detail__prose {
    font-size: var(--kb-text-lg);
    color: var(--kb-text-muted);
  }

  .detail__prose :global(p) {
    line-height: 1.7;
  }

  .detail__prose :global(strong) {
    color: var(--kb-ink);
  }

  /* ---- sidebar panels ---- */
  .detail__side {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    position: sticky;
    top: calc(var(--kb-header-h) + 1.5rem);
  }

  .panel {
    padding: var(--kb-space-5);
    background: var(--kb-white);
    border: var(--kb-border);
    border-radius: var(--kb-radius-lg);
  }

  .panel__title {
    font-size: var(--kb-text-xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kb-blue);
    margin-bottom: var(--kb-space-4);
  }

  .panel__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-3);
    font-size: var(--kb-text-sm);
    color: var(--kb-text-muted);
  }

  .panel__features li {
    position: relative;
    padding-left: 1.4rem;
    line-height: 1.55;
  }

  .panel__features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--kb-cyan);
  }

  .panel__spec {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem var(--kb-space-4);
    font-size: var(--kb-text-sm);
    margin: 0;
  }

  .panel__spec dt {
    color: var(--kb-text-subtle);
  }

  .panel__spec dd {
    margin: 0;
    font-weight: 600;
    color: var(--kb-ink);
    font-variant-numeric: tabular-nums;
  }

  .panel__brands {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-3);
  }

  .panel__brands li {
    display: flex;
    flex-direction: column;
  }

  .panel__brand-name {
    font-weight: 700;
    color: var(--kb-blue);
    font-size: var(--kb-text-sm);
  }

  .panel__brand-rel {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kb-text-subtle);
  }

  .panel__link {
    display: inline-block;
    margin-top: var(--kb-space-4);
    font-size: var(--kb-text-xs);
    font-weight: 650;
    text-decoration: none;
  }

  .panel--cta {
    background: var(--kb-blue-tint);
    border-color: color-mix(in srgb, var(--kb-blue) 22%, transparent);
  }

  .panel--cta p {
    font-size: var(--kb-text-sm);
    color: var(--kb-text-muted);
    margin-bottom: var(--kb-space-4);
  }

  .panel--cta .kb-btn {
    width: 100%;
  }

  /* ---- other products ---- */
  .others__title {
    font-size: var(--kb-text-2xl);
    margin-bottom: var(--kb-space-5);
  }

  .others {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--kb-space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .others a {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-2);
    height: 100%;
    padding: var(--kb-space-5);
    background: var(--kb-white);
    border: var(--kb-border);
    border-radius: var(--kb-radius-lg);
    text-decoration: none;
    transition: border-color var(--kb-transition), box-shadow var(--kb-transition);
  }

  .others a:hover {
    border-color: color-mix(in srgb, var(--kb-blue) 32%, transparent);
    box-shadow: var(--kb-shadow-sm);
  }

  .others__name {
    font-weight: 650;
    color: var(--kb-blue);
  }

  .others__sum {
    font-size: var(--kb-text-sm);
    color: var(--kb-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .detail {
      grid-template-columns: 1fr;
    }
    .detail__side {
      position: static;
    }
  }
</style>
